# Maintainer: Someone <someone@example.com>
# The mixed case the old file-wide gate missed: one real checksum is present
# (on the local .desktop file), so "any real hash anywhere -> bail" let this
# through -- yet the tarball itself is SKIP and its URL fetches v1.9.0 while
# pkgver says 2.0.0. Positional pairing judges the tarball entry on its own.
pkgname=pkg-pkgver-url-mismatch-mixed
pkgver=2.0.0
pkgrel=1
arch=('x86_64')
source=("https://downloads.example.com/dl/v1.9.0/tool-x86_64.tar.gz"
        "tool.desktop")
sha256sums=('SKIP'
            'b1946ac92492d2347c6235b4d2611184a1b2c3d4e5f60718293a4b5c6d7e8f901')

package() {
    install -Dm755 tool "$pkgdir/usr/bin/tool"
    install -Dm644 tool.desktop "$pkgdir/usr/share/applications/tool.desktop"
}
