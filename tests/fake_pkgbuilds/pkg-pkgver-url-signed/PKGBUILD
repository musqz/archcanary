# Maintainer: Someone <someone@example.com>
# Regression guard for the rework: a gpg-signed package whose tarball URL
# hard-codes a version string that isn't a substring of pkgver (1.4 vs 1.4.0)
# and whose sha256 is SKIP -- but a detached .sig is present, so gpg +
# validpgpkeys is what verifies the download. The source group carries a
# signature entry, so Pattern 16 skips it whole and must stay clean.
pkgname=pkg-pkgver-url-signed
pkgver=1.4.0
pkgrel=1
arch=('any')
validpgpkeys=('ABCDEF0123456789ABCDEF0123456789ABCDEF01')
source=("https://ftp.example.org/pub/tool/tool-1.4.tar.xz"
        "https://ftp.example.org/pub/tool/tool-1.4.tar.xz.sig")
sha256sums=('SKIP'
            'SKIP')

package() {
    install -Dm755 "$srcdir/tool" "$pkgdir/usr/bin/tool"
}
