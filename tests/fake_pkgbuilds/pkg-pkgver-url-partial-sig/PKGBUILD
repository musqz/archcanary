# Maintainer: Someone <someone@example.com>
# The detached signature covers only docs.tar.gz; the main binary tarball is
# SKIP and its URL fetches v1.9.0 while pkgver says 2.0.0. A blanket
# "signature anywhere -> skip the group" would miss this; per-entry coverage
# does not.
pkgname=pkg-pkgver-url-partial-sig
pkgver=2.0.0
pkgrel=1
arch=('x86_64')
validpgpkeys=('ABCDEF0123456789ABCDEF0123456789ABCDEF01')
source=("https://downloads.example.com/dl/v1.9.0/tool-x86_64.tar.gz"
        "https://downloads.example.com/docs/docs.tar.gz"
        "https://downloads.example.com/docs/docs.tar.gz.asc")
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() { install -Dm755 tool "$pkgdir/usr/bin/tool"; }
