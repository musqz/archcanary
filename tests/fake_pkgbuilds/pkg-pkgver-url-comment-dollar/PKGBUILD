# Maintainer: Someone <someone@example.com>
# Evasion guard: a `$` in a trailing comment on the pkgver= line must not
# make Pattern 16 treat pkgver as a variable substitution and bail. pkgver
# is the literal 2.0.0; the source URL fetches v1.9.0 with sha256sums=SKIP.
pkgname=pkg-pkgver-url-comment-dollar
pkgver=2.0.0  # upstream renamed the $pkgver tag scheme in this release
pkgrel=1
arch=('x86_64')
source=("https://downloads.example.com/dl/v1.9.0/tool-x86_64.tar.gz")
sha256sums=('SKIP')

package() { install -Dm755 tool "$pkgdir/usr/bin/tool"; }
