post_install() {
    # None of the sudo mentions below are an actual privileged action —
    # they are all instruction text (echo, printf, a heredoc, a comment).
    echo "To start it now, run:"
    echo "    sudo systemctl enable --now pkg-priv-esc-echo.timer"
    printf 'Then: sudo systemctl start pkg-priv-esc-echo.service\n'
    cat <<'EOF'
Manual setup:
        sudo systemctl daemon-reload
        sudo systemctl enable --now pkg-priv-esc-echo.path
EOF
    # sudo cp is only referenced here as a note, never run.
}
