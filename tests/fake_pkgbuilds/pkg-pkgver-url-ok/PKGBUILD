# Maintainer: Someone <someone@example.com>
# Would trip the pkgver/URL-mismatch check on a naive reading (a SKIP is
# present, pkgver isn't a literal substring of the tarball URL) but must
# NOT: one URL carries the version via a ${pkgver%%.*} parameter expansion,
# and one real checksum is present so the package isn't wholly unverified.
pkgname=pkg-pkgver-url-ok
pkgver=1.2.3
pkgrel=1
source=("$pkgname-$pkgver.tar.gz::https://downloads.example.com/releases/${pkgver%%.*}/x/$pkgname.tar.gz"
        "logo.png::https://downloads.example.com/assets/logo.png")
sha256sums=('SKIP'
            'a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f901')

package() {
    install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
}
